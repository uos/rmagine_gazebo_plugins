<?xml version="1.0"?>
<package format="3">
  <name>rmagine_gazebo_plugins</name>
  <version>0.0.0</version>
  <description>The rmagine_gazebo_plugins package</description>

  <!-- One maintainer tag required, multiple allowed, one person per tag -->
  <!-- Example:  -->
  <!-- <maintainer email="jane.doe@example.com">Jane Doe</maintainer> -->
  <maintainer email="amock@uos.de">Alexander Mock</maintainer>


  <!-- One license tag required, multiple allowed, one license per tag -->
  <!-- Commonly used license strings: -->
  <!--   BSD, MIT, Boost Software License, GPLv2, GPLv3, LGPLv2.1, LGPLv3 -->
  <license>TODO</license>


  <!-- Url tags are optional, but multiple are allowed, one per tag -->
  <!-- Optional attribute type can be: website, bugtracker, or repository -->
  <!-- Example: -->
  <!-- <url type="website">http://wiki.ros.org/gazebo_rmagine_plugin</url> -->


  <!-- Author tags are optional, multiple are allowed, one per tag -->
  <!-- Authors do not have to be maintainers, but could be -->
  <!-- Example: -->
  <!-- <author email="jane.doe@example.com">Jane Doe</author> -->


  <!-- The *depend tags are used to specify dependencies -->
  <!-- Dependencies can be catkin packages or system dependencies -->
  <!-- Examples: -->
  <!-- Use depend as a shortcut for packages that are both build and exec dependencies -->
  <!--   <depend>roscpp</depend> -->
  <!--   Note that this is equivalent to the following: -->
  <!--   <build_depend>roscpp</build_depend> -->
  <!--   <exec_depend>roscpp</exec_depend> -->
  <!-- Use build_depend for packages you need at compile time: -->
  <!--   <build_depend>message_generation</build_depend> -->
  <!-- Use build_export_depend for packages you need in order to build against this package: -->
  <!--   <build_export_depend>message_generation</build_export_depend> -->
  <!-- Use buildtool_depend for build tool packages: -->
  <!--   <buildtool_depend>catkin</buildtool_depend> -->
  <!-- Use exec_depend for packages you need at runtime: -->
  <!--   <exec_depend>message_runtime</exec_depend> -->
  <!-- Use test_depend for packages you need only for testing: -->
  <!--   <test_depend>gtest</test_depend> -->
  <!-- Use doc_depend for packages you need only for building documentation: -->
  <!--   <doc_depend>doxygen</doc_depend> -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <!-- Only needed by the Python fixture-test harness (subscribes to the
       ros_gz_bridge-converted /scan, /points topics); the C++ plugin
       itself is gz-transport-native and has no ROS dependency. -->
  <exec_depend>sensor_msgs_py</exec_depend>
  <!-- Standard Gazebo per ROS distro: Fortress (ignition-*) on Humble,
       Harmonic (gz-*) on Jazzy+. See CMakeLists.txt's find_package cascade
       and include/rmagine_gazebo_plugins/gz/gz_compat.hpp. -->
  <depend condition="$ROS_DISTRO == 'humble'">ignition-gazebo6</depend>
  <depend condition="$ROS_DISTRO == 'humble'">ignition-plugin1</depend>
  <depend condition="$ROS_DISTRO == 'humble'">ignition-transport11</depend>
  <depend condition="$ROS_DISTRO == 'humble'">ignition-common4</depend>
  <depend condition="$ROS_DISTRO == 'humble'">ignition-math6</depend>
  <depend condition="$ROS_DISTRO == 'humble'">ignition-msgs8</depend>
  <depend condition="$ROS_DISTRO == 'humble'">ignition-rendering6</depend>
  <depend condition="$ROS_DISTRO != 'humble'">gz-sim8</depend>
  <depend condition="$ROS_DISTRO != 'humble'">gz-plugin2</depend>
  <depend condition="$ROS_DISTRO != 'humble'">gz-transport13</depend>
  <depend condition="$ROS_DISTRO != 'humble'">gz-common5</depend>
  <depend condition="$ROS_DISTRO != 'humble'">gz-math7</depend>
  <depend condition="$ROS_DISTRO != 'humble'">gz-msgs10</depend>
  <depend condition="$ROS_DISTRO != 'humble'">gz-rendering8</depend>
  <depend>ros_gz_bridge</depend>
  <depend>ros_gz_sim</depend>
  <depend>rmagine</depend>
  <depend>yaml-cpp</depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_msgs</depend>
  <depend>tf2</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>

  <!-- Robot example (launch/robot_demo.launch.py) -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>urdf</exec_depend>
  <test_depend>ament_cmake_test</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
