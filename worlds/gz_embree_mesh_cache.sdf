<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="default">
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics" />
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands" />
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster" />

    <!-- Regression coverage for mesh-by-URI caching (README.md, "Mesh-by-URI
         caching") -- three separate static entities all referencing the
         SAME mesh file (testdata/embree_harmonic/box_test.ply), at three
         different poses, plus an unrelated moving box (below) to force
         many rebuild passes over the capture window.

         Expected: exactly 1 cache-miss load of that mesh file, total,
         ever -- shared across all 3 entities and every rebuild pass the
         mover forces. See check_mesh_cache_fixture.py, and
         rmagine_embree_map_system.cpp's own comment on the real bug this
         fixture found (a per-pass first-use guard was blocking legitimate
         cache hits whenever 2+ entities shared an already-cached mesh,
         fixed on both the Embree and OptiX map systems).
         Separately, instancing still gives each entity its own
         independent transform -- if the cache/instance system regressed
         to sharing a raw (non-instanced) geometry, these 3 boxes would
         collapse onto whichever entity's transform was applied last,
         instead of appearing at their real, distinct poses. -->
    <plugin name="rmagine_embree_map_system" filename="librmagine_embree_map_system.so">
      <ignore_model>sensor_model</ignore_model>
      <debug>true</debug>
      <update>
        <rate_limit>30</rate_limit>
        <delta_trans>0.001</delta_trans>
        <delta_rot>0.001</delta_rot>
        <delta_scale>0.001</delta_scale>
      </update>
    </plugin>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="target_box_1">
      <static>true</static>
      <pose>3 0 1 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>file://MESH_CACHE_URI_PLACEHOLDER</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <model name="target_box_2">
      <static>true</static>
      <pose>5 -2 1 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>file://MESH_CACHE_URI_PLACEHOLDER</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <model name="target_box_3">
      <static>true</static>
      <pose>7 2 1 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>file://MESH_CACHE_URI_PLACEHOLDER</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- The 3 mesh-sharing entities above are all static -- on their own
         they'd only ever trigger ONE rebuild pass total (the initial
         scene build), which isn't enough to distinguish "caches across
         passes" from "never rebuilds a static scene at all". This mover
         (unrelated geometry, not sharing box_test.ply) forces many
         rebuild passes over the capture window, so the real check
         (cache_miss_count stays at 3, the initial loads, and does NOT
         grow across dozens of subsequent passes) is meaningful. -->
    <model name="mover">
      <static>false</static>
      <pose>10 0 1 0 0 0</pose>
      <plugin name="test_box_mover_system" filename="libtest_box_mover_system.so">
        <axis>1 0 0</axis>
        <amplitude>0.5</amplitude>
        <period>2.0</period>
      </plugin>
      <link name="link">
        <gravity>false</gravity>
        <velocity_decay>
          <linear>1.0</linear>
          <angular>1.0</angular>
        </velocity_decay>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.3 0.3 0.3</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <model name="sensor_model">
      <static>true</static>
      <pose>0 0 1 0 0 0</pose>
      <plugin name="rmagine_embree_sensor_system" filename="librmagine_embree_sensor_system.so">
        <map_key>default</map_key>
        <frame>sensor_link</frame>
        <topic_scan>scan</topic_scan>
        <topic_points>points</topic_points>
        <update_rate>5</update_rate>
        <min_angle>-1.0472</min_angle>
        <max_angle>1.0472</max_angle>
        <samples>400</samples>
        <range_min>0.2</range_min>
        <range_max>50.0</range_max>
        <debug>true</debug>
      </plugin>
      <link name="sensor_link">
        <visual name="sensor_visual">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.1 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
